// Signal Garden — ADX (Azure Data Explorer) schema for the Translink SEQ slice.
// Run these against your free ADX cluster (https://dataexplorer.azure.com) in a
// database named `signalgarden`. Free cluster: no subscription/card required.
//
// Apply top-to-bottom. `.create` commands are idempotent-ish: re-running a
// `.create table` with the same schema is a no-op; use `.create-or-alter` for
// functions so edits take effect on re-run.

// ---------------------------------------------------------------------------
// 1. Raw normalised observations (one row per vehicle report per poll).
// ---------------------------------------------------------------------------
.create table VehicleObservations (
    EventTime: datetime,
    IngestionTime: datetime,
    VehicleId: string,
    TripId: string,
    RouteId: string,
    Latitude: real,
    Longitude: real,
    Bearing: real,
    Speed: real,
    CurrentStopSequence: int,
    Source: string,
    StopId: string,
    CurrentStatus: string
)

// Columns added after the table first went live must be appended, never inserted:
// the worker uploads CSV in column order. On an existing table, apply with:
// .alter-merge table VehicleObservations (StopId: string, CurrentStatus: string)

// JSON ingestion mapping (OPTIONAL — the ingest worker can also pass the column
// mapping inline via the SDK). Keep it on ONE line: the ```...``` string
// delimiter and the JSON must stay together or the web UI parser rejects it.
.create-or-alter table VehicleObservations ingestion json mapping "VehicleObservations_json" ```[{"column":"EventTime","path":"$.EventTime"},{"column":"IngestionTime","path":"$.IngestionTime"},{"column":"VehicleId","path":"$.VehicleId"},{"column":"TripId","path":"$.TripId"},{"column":"RouteId","path":"$.RouteId"},{"column":"Latitude","path":"$.Latitude"},{"column":"Longitude","path":"$.Longitude"},{"column":"Bearing","path":"$.Bearing"},{"column":"Speed","path":"$.Speed"},{"column":"CurrentStopSequence","path":"$.CurrentStopSequence"},{"column":"Source","path":"$.Source"},{"column":"StopId","path":"$.StopId"},{"column":"CurrentStatus","path":"$.CurrentStatus"}]```

// Keep the experiment cheap: drop raw data after 30 days.
.alter-merge table VehicleObservations policy retention softdelete = 30d

// Queued ingestion waits up to 5 min by default to build a batch. Our polls are
// tiny (~400 rows / 20 s), so seal batches after 30 s instead and data shows
// up in queries within about a minute.
.alter table VehicleObservations policy ingestionbatching '{"MaximumBatchingTimeSpan":"00:00:30","MaximumNumberOfItems":500,"MaximumRawDataSizeMB":1024}'

// ---------------------------------------------------------------------------
// 1b. Reference layers from OpenStreetMap (© OpenStreetMap contributors, ODbL).
//     Loaded and refreshed by infra/adx/reference/load_osm_reference.py.
//     Geometry is GeoJSON, as ADX's geo_* functions expect.
// ---------------------------------------------------------------------------
.create-merge table Cafes (OsmId: string, Name: string, Latitude: real, Longitude: real)

.create-merge table WaterBodies (OsmId: string, Name: string, Kind: string, Geometry: dynamic)

.create-merge table Bridges (OsmId: string, Name: string, Kind: string, Geometry: dynamic)

// The loader replaces each table's contents, which needs table-admin rights:
// .add table Cafes admins ('aaduser=<object-id>;<tenant-id>') 'OSM reference loader'
// (and the same for WaterBodies and Bridges)

// ---------------------------------------------------------------------------
// 2. Query functions (back the API's IVehicleReadRepository).
// ---------------------------------------------------------------------------

// Latest known position per vehicle, optionally filtered to one route.
// Backs GetLatestPositionsAsync.
.create-or-alter function LatestVehiclePositions(routeFilter: string = "") {
    VehicleObservations
    | where isempty(routeFilter) or RouteId == routeFilter
    | summarize arg_max(EventTime, *) by VehicleId
}

// Position history for one vehicle over a window, oldest first.
// Backs GetVehicleHistoryAsync.
.create-or-alter function VehicleHistory(vehicle: string, window: timespan = 1h) {
    VehicleObservations
    | where VehicleId == vehicle and EventTime > ago(window)
    | order by EventTime asc
}

// ---------------------------------------------------------------------------
// 3. Sketch: time-series exploration (uncomment/adapt once data flows).
// ---------------------------------------------------------------------------
// Active vehicle count per minute over the last 2h — a simple "pulse" signal.
// VehicleObservations
// | where EventTime > ago(2h)
// | summarize ActiveVehicles = dcount(VehicleId) by bin(EventTime, 1m)
// | render timechart
//
// Anomaly detection on that pulse (ADX built-in):
// VehicleObservations
// | where EventTime > ago(1d)
// | make-series ActiveVehicles = dcount(VehicleId) on EventTime step 5m
// | extend (anomalies, score, baseline) = series_decompose_anomalies(ActiveVehicles)
// | render anomalychart
