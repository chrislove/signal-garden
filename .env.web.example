# Copy to .env.web (git-ignored) and fill in. Read by compose.yaml's web service.

# ADX query endpoint (the cluster URI) — the dashboard only reads.
Api__Adx__QueryUri=

# Show the staged, clearly labelled SYNTHETIC demo event.
Api__Demo__SyntheticEvents=true

# Service principal with Viewer rights on the signalgarden database.
# Picked up by DefaultAzureCredential.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
