# Copy to .env.ingest (git-ignored) and fill in. Read by compose.yaml.

# ADX ingestion endpoint (the "Data ingestion URI" of the cluster).
Ingest__Adx__IngestUri=

# Service principal with Ingestor rights on the signalgarden database.
# Picked up by DefaultAzureCredential.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
